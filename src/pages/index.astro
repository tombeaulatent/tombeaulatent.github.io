---
import Layout from "../layouts/Layout.astro";
import AuroraBg from "../components/react/AuroraBg";
import { SITE } from "../data/site";
---

<Layout title={SITE.nom}>
  <section class="hero">
    <div class="hero-atmosphere" aria-hidden="true">
      <AuroraBg client:idle />
    </div>

    <div class="hero-content">
      <h1 class="hero-title">{SITE.nom}</h1>
      <p class="hero-subtitle">{SITE.accroche}</p>
      <div class="hero-actions">
        <a class="hero-btn hero-btn-primary" href="/live-coding">Portfolio</a>
        <a class="hero-btn hero-btn-ghost" href="/a-propos">À propos</a>
      </div>
    </div>
  </section>
</Layout>
