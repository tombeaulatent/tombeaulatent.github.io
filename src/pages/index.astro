---
import Layout from "../layouts/Layout.astro";
import AuroraBg from "../components/react/AuroraBg";
import { SITE } from "../data/nav";
---

<Layout title={SITE.name}>
  <section class="hero">
    <div class="hero-atmosphere" aria-hidden="true">
      <AuroraBg client:idle />
    </div>

    <div class="hero-content">
      <h1 class="hero-brand">{SITE.name}</h1>
    </div>
  </section>
</Layout>
