---
import Layout from "../layouts/Layout.astro";
import AuroraBg from "../components/react/AuroraBg";
---

<Layout title="tombeauLatent">
  <section class="hero">
    <div class="hero-atmosphere" aria-hidden="true">
      <AuroraBg client:idle />
    </div>

    <div class="hero-content">
      <h1 class="hero-title">tombeauLatent</h1>
      <p class="hero-subtitle">Développeuse & tatoueuse</p>
      <div class="hero-actions">
        <a class="hero-btn hero-btn-primary" href="/portfolio">Portfolio</a>
        <a class="hero-btn hero-btn-ghost" href="/a-propos">À propos</a>
      </div>
    </div>
  </section>
</Layout>
