---
import { ClientRouter, fade } from "astro:transitions";
import SiteHeader from "../components/react/SiteHeader";
import Outillage from "../components/react/Outillage";
import { SITE } from "../data/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = SITE.nom,
  description = "Portfolio sombre   gothique, technologie, mémoire latente.",
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = title === SITE.nom ? title : `${title} · ${SITE.nom}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#17151c" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader
        client:load
        transition:persist="nav"
        currentPath={currentPath}
      />
      <main
        class="site-main"
        transition:animate={fade({ duration: "600ms" })}
        transition:name="main"
      >
        <slot />
      </main>
      <footer class="site-footer page-pad" transition:persist="footer">
        <span>{SITE.nom}</span>
        <span>...</span>
      </footer>
      <Outillage client:load />
    </div>
  </body>
</html>
